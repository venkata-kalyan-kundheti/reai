NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/reai
CLIENT_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
MAX_FILE_MB=25
MAX_PAGES=300
GUEST_TTL_DAYS=7
COOKIE_SECRET=change-me-please-long-enough-secret-key-32-chars

LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-anthropic-api-key
LLM_MODEL=gemini-2.5-flash
SINGLE_PASS_LIMIT_CHARS=40000
SECTION_SIZE_CHARS=24000

VISION_PROVIDER=gemini
VISION_API_KEY=your-gemini-vision-api-key
VISION_MODEL=gemini-2.5-flash
MAX_VISION_PAGES=30

SOFFICE_PATH=soffice

# ---- Gemini traffic control: set these to YOUR tier's real limits (see Google AI Studio -> Rate limits) ----
LLM_FALLBACK_MODEL=            # optional, e.g. gemini-2.5-flash-lite (it has its own quota bucket)
LLM_RPM=8                      # requests per minute for one model
LLM_TPM=200000                 # tokens per minute for one model
LLM_MAX_CONCURRENT=2           # simultaneous requests per model
LLM_MAX_RETRIES=4              # retries on 429 / 503 / timeout / network error
LLM_FIRST_TOKEN_TIMEOUT_MS=60000
LLM_IDLE_TIMEOUT_MS=30000
LLM_REQUEST_TIMEOUT_MS=150000
LLM_QUEUE_TIMEOUT_MS=240000
LLM_INTERACTIVE_QUEUE_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_CONTINUATIONS=3
LLM_THINKING_BUDGET=           # 0 = no hidden reasoning (faster). Blank = auto (0 for *flash* models)
GENERATIONS_PER_10_MIN=12      # per visitor
ASKS_PER_10_MIN=30             # per visitor
VISION_RENDER_SCALE=1.6
