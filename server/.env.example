NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/reai
CLIENT_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
MAX_FILE_MB=25
MAX_PAGES=300
GUEST_TTL_DAYS=7
COOKIE_SECRET=change-me-please-long-enough-secret-key-32-chars

LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-anthropic-api-key
LLM_MODEL=gemini-2.5-flash
SINGLE_PASS_LIMIT_CHARS=120000
SECTION_SIZE_CHARS=60000

VISION_PROVIDER=gemini
VISION_API_KEY=your-gemini-vision-api-key
VISION_MODEL=gemini-2.5-flash
MAX_VISION_PAGES=30

SOFFICE_PATH=soffice
